# ============================================================
# REQUIRED CONFIGURATION
# ============================================================

# GitHub Configuration (REQUIRED)
# 1. Go to any GitHub page: <https://github.com/settings/tokens>.
# 2. Click **Tokens(classic)** and click **Generate new token**.
# 3. Add a note, choose an expiration, and select scopes to be **repo** and **workflow**.
# 4. Click **Generate token**, copy it and save it properly. You won't be able to see it again.
# 5. Paste the token into `backend/.env` as `GITHUB_TOKEN`.
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=your_github_username/ProgramAT-opensource

# Code-agent orchestration. Codex is the default; Claude and Copilot remain
# available through the ready-for-claude and ready-for-copilot issue labels.
CODE_AGENT=codex
# Install Codex CLI on the backend host and authenticate that service account
# separately with `codex login`. Do not reuse OPENAI_API_KEY implicitly.
CODEX_BINARY=/absolute/path/to/codex
# Use a dedicated home when different Codex CLI versions run on one account;
# their generated models caches may not be mutually compatible.
CODEX_HOME=/absolute/path/to/dedicated-codex-home
# Leave empty to use the authenticated Codex CLI profile's configured model.
CODEX_MODEL=
CODEX_BASE_BRANCH=main
# Must be outside the active repository checkout and writable by the backend.
CODEX_WORKTREE_ROOT=/tmp/programat-codex-worktrees

# Gemini Configuration (REQUIRED)
# 1. Go to Google AI Studio: <https://aistudio.google.com/app/apikey>
# 2. Sign in with your personal Google account.
# 3. Click **Create API key**.
# 4. Select an existing Google Cloud project or create a new one, then click **Create API key**.
# 5. Copy the generated key.
# 6. Paste the key into `backend/.env` as `GEMINI_API_KEY`.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# Temporarily skip the pre-issue brainstorming turn for faster experiments.
BRAINSTORMING_ENABLED=false

# Optional provider keys for LiteLLM-compatible models
# Set the keys required by the implementations listed in execution_policy.yaml.
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_OCR_MODEL=mistral-ocr-latest
DASHSCOPE_API_KEY=your_dashscope_api_key_here
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# Active model used by the backend and most tools.
# Keep the default Gemini model unless you want to switch providers.
# Examples: gemini-3-flash-preview, gpt-4o, claude-3-5-sonnet-20241022, groq/llama-3.3-70b-versatile, mistral/mistral-small-latest
LLM_MODEL=gemini-3-flash-preview

# Google Cloud Vision (REQUIRED for OCR-based tools)
# 1. Go to Google Cloud Console: <https://console.cloud.google.com>
# 2. Create or select a project and enable the **Cloud Vision API** in **Menu** -> **API & Services** -> **Enabled APIs & services**.
# 3. Create a service account: **Menu** -> **IAM & Admin** -> **Service Accounts** -> **Create service account**. Fill name/ID and click **Continue**.
# 4. Create a key: for this service account, select **Actions** -> **Manage Keys** -> **Add key** -> **Create new key** -> choose **JSON** -> **Create**. 
# 5. A JSON file will be downloaded. Copy the JSON file from the Downloads folder to the backend folder in the codespace. Rename the file to be `credentials.json`.
# 6. Set `GOOGLE_APPLICATION_CREDENTIALS` to the JSON file path.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ============================================================
# SERVER CONFIGURATION
# ============================================================

# Bind to localhost by default. For public deployments, put Caddy or another
# reverse proxy in front of the backend and keep port 8081 private.
HOST=127.0.0.1
PORT=8081
PAUSE_DURATION=5.0

# Legacy hosted-video compatibility policy. Executable lifecycle tools select
# their own frames and models for both Take Photo and Streaming.
STREAMING_EXECUTION_POLICY=hosted_video_only

# GPU-free hosted NVIDIA short-video streaming. The verified
# integrate.api.nvidia.com schema uses a small base64 MP4 in video_url.
NVIDIA_VIDEO_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VIDEO_API_KEY=
NVIDIA_VIDEO_MODEL=nvidia/nemotron-nano-12b-v2-vl
NVIDIA_VIDEO_INPUT_MODE=base64
VIDEO_VLM_PROVIDER=gemini
VIDEO_GEMINI_MODEL=gemini-3.1-flash-lite-preview
HOSTED_VIDEO_WINDOW_SECONDS=6
HOSTED_VIDEO_INTERVAL_SECONDS=3
HOSTED_VIDEO_OVERLAP_SECONDS=3
HOSTED_VIDEO_OUTPUT_FPS=4
HOSTED_VIDEO_MAX_WIDTH=1280
HOSTED_VIDEO_JPEG_QUALITY=80
HOSTED_VIDEO_CAPTURE_INTERVAL_MS=333
HOSTED_VIDEO_MAX_TOKENS=256
HOSTED_VIDEO_MAX_CLIP_BYTES=8388608
HOSTED_VIDEO_REQUEST_TIMEOUT_SECONDS=60
HOSTED_VIDEO_DUPLICATE_COOLDOWN_SECONDS=5
HOSTED_VIDEO_DEBUG_SAVE=false
# HOSTED_VIDEO_DEBUG_DIR=/absolute/path/to/hosted_video_debug
# Optional comma-separated additional models for the saved-clip comparison.
# NVIDIA_VIDEO_COMPARISON_MODELS=vendor/another-video-model

# Hosted multiframe experiment. No local NVIDIA service, RTSP, or GPU required.
NVIDIA_HOSTED_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_HOSTED_API_KEY=
# Leave empty to discover models and select the first vision-capable model.
NVIDIA_HOSTED_MODEL=
NVIDIA_HOSTED_WINDOW_SECONDS=2
NVIDIA_HOSTED_SAMPLE_FRAMES=6
NVIDIA_HOSTED_REQUEST_INTERVAL_SECONDS=1.5
NVIDIA_HOSTED_MAX_IN_FLIGHT=1
NVIDIA_HOSTED_REQUEST_TIMEOUT_SECONDS=60
NVIDIA_HOSTED_MAX_TOKENS=80

# RTVI microservice experiment. NVIDIA_RTVI_STREAMING_ENABLED is retained only
# as a legacy alias when NVIDIA_STREAMING_MODE is unset.
NVIDIA_RTVI_STREAMING_ENABLED=false
RTVI_BASE_URL=http://localhost:8000/v1
# Leave empty to select the first ID returned by GET /v1/models.
RTVI_MODEL_ID=
RTVI_CHUNK_DURATION_SECONDS=5
RTVI_CHUNK_OVERLAP_SECONDS=1
RTVI_REQUEST_TIMEOUT_SECONDS=30
RTVI_STARTUP_TIMEOUT_SECONDS=30
RTVI_RECONNECT_MAX_ATTEMPTS=3
RTVI_DUPLICATE_COOLDOWN_SECONDS=5
# Set true to reject a loaded model whose ID does not contain "nemotron".
RTVI_REQUIRE_NEMOTRON=false

# MediaMTX URL reachable by both this backend (FFmpeg publisher) and the RTVI
# deployment. Do not use localhost when RTVI runs in a different container/host.
PROGRAMAT_RTSP_PUBLIC_BASE_URL=rtsp://localhost:8554/programat
PROGRAMAT_RTSP_FPS=5
# Optional fixed output size; set both or leave both empty.
PROGRAMAT_RTSP_WIDTH=
PROGRAMAT_RTSP_HEIGHT=
# Absolute path may be used when ffmpeg is not on the backend service's PATH.
# PROGRAMAT_FFMPEG_BINARY=/usr/bin/ffmpeg

# Optional WebSocket auth token. If set, clients must connect with
# ?auth=<token>, ?token=<token>, Authorization: Bearer <token>, or
# X-ProgramAT-Auth: <token>.
# AUTH_TOKEN=replace_with_a_long_random_value

# ============================================================
# OPTIONAL CONFIGURATION
# ============================================================

# GCP Secret Manager (overrides the values above if configured)
# Only needed if you are managing secrets via GCP — most self-hosted
# deployments should leave these commented out and use the values above.
# GCP_PROJECT=your-project-id
# GITHUB_SECRET_ID=GITHUB_TOKEN
# Minimum seconds from completion of one streaming execution to the next.
MIN_STREAMING_EXECUTION_INTERVAL=2.0
